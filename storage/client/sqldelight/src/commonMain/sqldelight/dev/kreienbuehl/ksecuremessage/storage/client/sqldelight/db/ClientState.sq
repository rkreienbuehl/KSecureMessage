-- Local client state. Columns named sealed_* hold encrypted storage records
-- (docs/storage-encryption.md): key pairs, session state and pending message
-- frames never reach the database in plaintext. IDs, addresses, timestamps
-- and the other tables are plaintext metadata.
--
-- The sealed tables must stay identical to the DDL in
-- LegacyPlaintextMigration.kt, which rebuilds them for databases from before
-- schema version 6.

-- Single row. format: 0 = milestone 8 plaintext, still to be encrypted
-- (databases upgraded by 5.sqm); 1 = record encryption version 1. key_id is
-- the current storage key (new records are sealed with it) and key_check a
-- sealed empty record that proves that key; both NULL until the first open
-- binds a key.
--
-- Storage key rotation (schema version 7, see 6.sqm and
-- docs/storage-key-rotation.md): highest_key_id is the key ID high-water
-- mark; rotation_phase 0 STABLE, 1 PREPARING (next_key_id allocated, not
-- yet current), 2 MIGRATING (records of retiring_key_id are re-encrypted;
-- retiring_key_check proves that key), 3 RETIRING (no record uses
-- retiring_key_id; its provider key is being removed).
CREATE TABLE storage_encryption (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    format INTEGER NOT NULL,
    key_id INTEGER,
    key_check BLOB,
    highest_key_id INTEGER,
    rotation_phase INTEGER NOT NULL DEFAULT 0,
    next_key_id INTEGER,
    retiring_key_id INTEGER,
    retiring_key_check BLOB
);

INSERT INTO storage_encryption (id, format) VALUES (0, 1);

CREATE TABLE local_identity (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    sealed_identity BLOB NOT NULL
);

-- Device authentication key pair (milestone 12, schema version 8, see
-- 7.sqm and docs/server-authentication.md). Single row, sealed.
CREATE TABLE device_authentication_key (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    sealed_key_pair BLOB NOT NULL
);

-- Pending replacement key pair of a device authentication recovery
-- (milestone 14, schema version 9, see 8.sqm and docs/device-recovery.md).
-- Single row, sealed as record type 8. Promoted to device_authentication_key
-- once the server accepted the recovery.
CREATE TABLE device_authentication_recovery_key (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    sealed_key_pair BLOB NOT NULL
);

-- Single row. awaits_upgrade_key is 1 only for a database that held a local
-- identity before schema version 8 and has not stored a device
-- authentication key since; a new database starts with 0.
CREATE TABLE device_authentication_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    awaits_upgrade_key INTEGER NOT NULL
);

INSERT INTO device_authentication_state (id, awaits_upgrade_key) VALUES (0, 0);

-- created_at and replaced_at (epoch milliseconds) were added in schema
-- version 4, see 3.sqm. NULL means a key from before that version that the
-- client has not stamped yet. replaced_at is NULL for the current key.
-- Rows are deleted once their grace period is over.
CREATE TABLE signed_pre_key (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id BETWEEN 0 AND 2147483647),
    sealed_key_pair BLOB NOT NULL,
    created_at INTEGER,
    replaced_at INTEGER
);

CREATE TABLE one_time_pre_key (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id BETWEEN 0 AND 2147483647),
    sealed_key_pair BLOB NOT NULL
);

-- Single row. The highest_* columns are ID high-water marks: they keep their
-- value when keys are deleted, so IDs are never reused.
CREATE TABLE pre_key_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    current_signed_pre_key_id INTEGER REFERENCES signed_pre_key(id),
    highest_signed_pre_key_id INTEGER,
    highest_one_time_pre_key_id INTEGER
);

INSERT INTO pre_key_state (id) VALUES (0);

CREATE TABLE session (
    remote_user_id TEXT NOT NULL,
    remote_device_id TEXT NOT NULL,
    sealed_state BLOB NOT NULL,
    PRIMARY KEY (remote_user_id, remote_device_id)
);

-- Remote identity keys pinned on first contact (TOFU). Public keys. Rows are
-- never deleted; a key is replaced only by an explicitly accepted identity
-- change. Added in schema version 2, see 1.sqm. verification (version 10,
-- 9.sqm; last column like ALTER TABLE adds it): 0 unverified, 1 verified,
-- always for exactly the pinned key.
CREATE TABLE remote_identity (
    remote_user_id TEXT NOT NULL,
    remote_device_id TEXT NOT NULL,
    identity_key BLOB NOT NULL,
    verification INTEGER NOT NULL DEFAULT 0 CHECK (verification IN (0, 1)),
    PRIMARY KEY (remote_user_id, remote_device_id)
);

-- Session initiations that must never become current again (replaced or
-- lost a collision). Public values. Added in schema version 3, see 2.sqm.
-- signed_pre_key_id (version 4, 3.sqm) is the local signed prekey accepting
-- the initiation needs; rows are deleted once that key is deleted. NULL rows
-- are kept forever.
CREATE TABLE retired_session_initiation (
    remote_user_id TEXT NOT NULL,
    remote_device_id TEXT NOT NULL,
    initiation_id BLOB NOT NULL CHECK (length(initiation_id) = 32),
    signed_pre_key_id INTEGER,
    PRIMARY KEY (remote_user_id, remote_device_id, initiation_id)
);

-- Sent application messages awaiting the recipient's acknowledgement.
-- sealed_frame is the encrypted reliability frame (it contains application
-- plaintext). AUTOINCREMENT keeps sequence numbers from being reused after
-- deletes, so they give the send order. Added in schema version 5, see 4.sqm.
CREATE TABLE pending_outbound_message (
    sequence INTEGER PRIMARY KEY AUTOINCREMENT,
    recipient_user_id TEXT NOT NULL,
    recipient_device_id TEXT NOT NULL,
    message_id BLOB NOT NULL CHECK (length(message_id) = 16),
    sealed_frame BLOB NOT NULL,
    UNIQUE (recipient_user_id, recipient_device_id, message_id)
);

-- Logical message IDs accepted per sender, for duplicate suppression. Rows
-- are never deleted. Added in schema version 5, see 4.sqm.
CREATE TABLE processed_inbound_message (
    sender_user_id TEXT NOT NULL,
    sender_device_id TEXT NOT NULL,
    message_id BLOB NOT NULL CHECK (length(message_id) = 16),
    PRIMARY KEY (sender_user_id, sender_device_id, message_id)
);

selectStorageEncryption:
SELECT format, key_id, key_check, highest_key_id, rotation_phase, next_key_id, retiring_key_id, retiring_key_check
FROM storage_encryption;

bindStorageKey:
UPDATE storage_encryption SET key_id = :keyId, key_check = :keyCheck, highest_key_id = :keyId;

-- Storage key rotation (docs/storage-key-rotation.md). Each statement checks
-- the phase it leaves, so a stale caller changes nothing.

prepareStorageKeyRotation:
UPDATE storage_encryption SET rotation_phase = 1, next_key_id = :nextKeyId, highest_key_id = :nextKeyId
WHERE rotation_phase = 0 AND key_id = :currentKeyId;

activateStorageKey:
UPDATE storage_encryption
SET rotation_phase = 2, retiring_key_id = key_id, retiring_key_check = key_check,
    key_id = next_key_id, key_check = :keyCheck, next_key_id = NULL
WHERE rotation_phase = 1 AND key_id = :retiringKeyId AND next_key_id = :keyId;

markStorageKeyRetiring:
UPDATE storage_encryption SET rotation_phase = 3, retiring_key_check = NULL
WHERE rotation_phase = 2 AND key_id = :keyId AND retiring_key_id = :retiringKeyId;

finishStorageKeyRotation:
UPDATE storage_encryption SET rotation_phase = 0, retiring_key_id = NULL
WHERE rotation_phase = 3 AND key_id = :keyId AND retiring_key_id = :retiringKeyId;

-- Re-encryption batches: rows whose record does not start with the current
-- key's header, given as upper-case hex (malformed rows too, so they fail
-- the batch instead of being skipped). Fixed order for reproducible progress.

selectIdentityToReseal:
SELECT sealed_identity FROM local_identity WHERE hex(substr(sealed_identity, 1, 10)) IS NOT :header;

updateIdentityRecord:
UPDATE local_identity SET sealed_identity = ?;

selectDeviceAuthenticationKeyToReseal:
SELECT sealed_key_pair FROM device_authentication_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header;

updateDeviceAuthenticationKeyRecord:
UPDATE device_authentication_key SET sealed_key_pair = ?;

selectDeviceAuthenticationRecoveryKeyToReseal:
SELECT sealed_key_pair FROM device_authentication_recovery_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header;

updateDeviceAuthenticationRecoveryKeyRecord:
UPDATE device_authentication_recovery_key SET sealed_key_pair = ?;

selectSignedPreKeysToReseal:
SELECT id, sealed_key_pair FROM signed_pre_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header ORDER BY id LIMIT :limit;

updateSignedPreKeyRecord:
UPDATE signed_pre_key SET sealed_key_pair = ? WHERE id = ?;

selectOneTimePreKeysToReseal:
SELECT id, sealed_key_pair FROM one_time_pre_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header ORDER BY id LIMIT :limit;

updateOneTimePreKeyRecord:
UPDATE one_time_pre_key SET sealed_key_pair = ? WHERE id = ?;

selectSessionsToReseal:
SELECT remote_user_id, remote_device_id, sealed_state FROM session
WHERE hex(substr(sealed_state, 1, 10)) IS NOT :header ORDER BY remote_user_id, remote_device_id LIMIT :limit;

updateSessionRecord:
UPDATE session SET sealed_state = ? WHERE remote_user_id = ? AND remote_device_id = ?;

selectPendingOutboundToReseal:
SELECT sequence, recipient_user_id, recipient_device_id, message_id, sealed_frame FROM pending_outbound_message
WHERE hex(substr(sealed_frame, 1, 10)) IS NOT :header ORDER BY sequence LIMIT :limit;

updatePendingOutboundRecord:
UPDATE pending_outbound_message SET sealed_frame = ? WHERE sequence = ?;

countRecordsToReseal:
SELECT (SELECT count(*) FROM local_identity WHERE hex(substr(sealed_identity, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM device_authentication_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM device_authentication_recovery_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM signed_pre_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM one_time_pre_key WHERE hex(substr(sealed_key_pair, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM session WHERE hex(substr(sealed_state, 1, 10)) IS NOT :header)
    + (SELECT count(*) FROM pending_outbound_message WHERE hex(substr(sealed_frame, 1, 10)) IS NOT :header);

countSealedRecords:
SELECT (SELECT count(*) FROM local_identity) + (SELECT count(*) FROM device_authentication_key)
    + (SELECT count(*) FROM device_authentication_recovery_key)
    + (SELECT count(*) FROM signed_pre_key)
    + (SELECT count(*) FROM one_time_pre_key) + (SELECT count(*) FROM session)
    + (SELECT count(*) FROM pending_outbound_message);

selectIdentity:
SELECT sealed_identity FROM local_identity;

insertIdentity:
INSERT INTO local_identity (id, sealed_identity) VALUES (0, ?);

selectDeviceAuthenticationKey:
SELECT sealed_key_pair FROM device_authentication_key;

-- Plain INSERT: the primary key rejects a second key.
insertDeviceAuthenticationKey:
INSERT INTO device_authentication_key (id, sealed_key_pair) VALUES (0, ?);

deleteDeviceAuthenticationKey:
DELETE FROM device_authentication_key;

selectDeviceAuthenticationRecoveryKey:
SELECT sealed_key_pair FROM device_authentication_recovery_key;

-- Plain INSERT: the primary key rejects a second pending key.
insertDeviceAuthenticationRecoveryKey:
INSERT INTO device_authentication_recovery_key (id, sealed_key_pair) VALUES (0, ?);

deleteDeviceAuthenticationRecoveryKey:
DELETE FROM device_authentication_recovery_key;

selectDeviceAuthenticationAwaitsUpgradeKey:
SELECT awaits_upgrade_key FROM device_authentication_state;

clearDeviceAuthenticationAwaitsUpgradeKey:
UPDATE device_authentication_state SET awaits_upgrade_key = 0;

selectRemoteIdentity:
SELECT identity_key FROM remote_identity WHERE remote_user_id = ? AND remote_device_id = ?;

selectRemoteIdentityRecord:
SELECT identity_key, verification FROM remote_identity WHERE remote_user_id = ? AND remote_device_id = ?;

-- Plain INSERT: the primary key rejects a second pin for the same device.
insertRemoteIdentity:
INSERT INTO remote_identity (remote_user_id, remote_device_id, identity_key, verification) VALUES (?, ?, ?, 0);

-- Guarded by the pinned key: verification never moves to another key.
updateRemoteIdentityVerification:
UPDATE remote_identity SET verification = ?
WHERE remote_user_id = ? AND remote_device_id = ? AND identity_key = ?;

-- Compare-and-set on the expected key; the new key starts unverified.
replaceRemoteIdentity:
UPDATE remote_identity SET identity_key = ?, verification = 0
WHERE remote_user_id = ? AND remote_device_id = ? AND identity_key = ?;

selectSession:
SELECT sealed_state FROM session WHERE remote_user_id = ? AND remote_device_id = ?;

upsertSession:
INSERT OR REPLACE INTO session (remote_user_id, remote_device_id, sealed_state) VALUES (?, ?, ?);

deleteSession:
DELETE FROM session WHERE remote_user_id = ? AND remote_device_id = ?;

countRetiredSessionInitiation:
SELECT count(*) FROM retired_session_initiation
WHERE remote_user_id = ? AND remote_device_id = ? AND initiation_id = ?;

insertRetiredSessionInitiation:
INSERT OR IGNORE INTO retired_session_initiation (remote_user_id, remote_device_id, initiation_id, signed_pre_key_id)
VALUES (?, ?, ?, ?);

selectRetiredSignedPreKeyIds:
SELECT DISTINCT signed_pre_key_id FROM retired_session_initiation WHERE signed_pre_key_id IS NOT NULL;

deleteRetiredForSignedPreKey:
DELETE FROM retired_session_initiation WHERE signed_pre_key_id = ?;

selectPreKeyState:
SELECT current_signed_pre_key_id, highest_signed_pre_key_id, highest_one_time_pre_key_id FROM pre_key_state;

selectSignedPreKey:
SELECT sealed_key_pair FROM signed_pre_key WHERE id = ?;

insertSignedPreKey:
INSERT INTO signed_pre_key (id, sealed_key_pair, created_at) VALUES (?, ?, ?);

-- Moves the current key into its grace period. Runs before makeSignedPreKeyCurrent.
markCurrentSignedPreKeyReplaced:
UPDATE signed_pre_key SET replaced_at = :replacedAt
WHERE id = (SELECT current_signed_pre_key_id FROM pre_key_state);

selectSignedPreKeyInfos:
SELECT signed_pre_key.id, signed_pre_key.id IS pre_key_state.current_signed_pre_key_id AS is_current, created_at, replaced_at
FROM signed_pre_key, pre_key_state ORDER BY signed_pre_key.id;

stampLegacySignedPreKeyCreation:
UPDATE signed_pre_key SET created_at = :at WHERE created_at IS NULL;

stampLegacySignedPreKeyReplacement:
UPDATE signed_pre_key SET replaced_at = :at
WHERE replaced_at IS NULL AND id IS NOT (SELECT current_signed_pre_key_id FROM pre_key_state);

deleteSignedPreKey:
DELETE FROM signed_pre_key WHERE id = ?;

makeSignedPreKeyCurrent:
UPDATE pre_key_state SET current_signed_pre_key_id = :id, highest_signed_pre_key_id = :id;

selectOneTimePreKey:
SELECT sealed_key_pair FROM one_time_pre_key WHERE id = ?;

selectOneTimePreKeys:
SELECT id, sealed_key_pair FROM one_time_pre_key ORDER BY id;

countOneTimePreKeys:
SELECT count(*) FROM one_time_pre_key;

insertOneTimePreKey:
INSERT INTO one_time_pre_key (id, sealed_key_pair) VALUES (?, ?);

deleteOneTimePreKey:
DELETE FROM one_time_pre_key WHERE id = ?;

setHighestOneTimePreKeyId:
UPDATE pre_key_state SET highest_one_time_pre_key_id = ?;

insertPendingOutbound:
INSERT INTO pending_outbound_message (recipient_user_id, recipient_device_id, message_id, sealed_frame) VALUES (?, ?, ?, ?);

selectPendingOutbound:
SELECT sequence, sealed_frame FROM pending_outbound_message
WHERE recipient_user_id = ? AND recipient_device_id = ? AND message_id = ?;

selectPendingOutboundFor:
SELECT sequence, message_id, sealed_frame FROM pending_outbound_message
WHERE recipient_user_id = ? AND recipient_device_id = ? ORDER BY sequence;

deletePendingOutbound:
DELETE FROM pending_outbound_message WHERE recipient_user_id = ? AND recipient_device_id = ? AND message_id = ?;

countProcessedInbound:
SELECT count(*) FROM processed_inbound_message WHERE sender_user_id = ? AND sender_device_id = ? AND message_id = ?;

insertProcessedInbound:
INSERT OR IGNORE INTO processed_inbound_message (sender_user_id, sender_device_id, message_id) VALUES (?, ?, ?);
